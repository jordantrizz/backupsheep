                                           class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md">
                                    <p x-show="scheduleErrors.name" class="mt-2 text-sm text-red-600" id="email-error"
                                       x-text="scheduleErrors.name"></p>
                                </div>
                            </div>
                            <div class="sm:col-span-6">
                                <div>
                                  <label class="text-base font-medium text-gray-900">Schedule Type <a class="text-indigo-500"
