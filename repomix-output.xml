                            <div class="mt-2">
                                <p class="text-sm text-gray-700" x-show="!schedule.id">
                                    You are creating schedule for <br/><strong>{{ object.name }}</strong>
                                </p>
                                <p class="text-sm text-gray-700" x-show="schedule.id">
                                    You are modifying schedule for <br/><strong>{{ object.name }}</strong>
                                </p>
                            </div>
                        </div>
