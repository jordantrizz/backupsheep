        # _stdin, _stdout,_stderr = ssh.exec_command(f"curl -X PUT -H 'Content-Type: application/octet-stream' --upload-file {bs_backup_tar} '{signed_url}'", timeout=command_timeout)
        # _stdout.channel.set_combine_stderr(True)
