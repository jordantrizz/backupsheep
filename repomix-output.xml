        sftp.get(bs_backup_snar, snar_file_path)

        #Cleanup files from remote server.
        sftp.remove(bs_backup_snar)
        sftp.remove(bs_backup_tar)

        # For dfferential backups we need to upload snar file for each backup. Because we only need main backup
        # and then point backup to restore.
        upload_snar_file(snar_file_path, snar_file_bs_storage, False)

        """
        Get list of files in tar and upload it. 
