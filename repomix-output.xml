                        msg = f"Deleted file from WordPress: {backup_file} using URL: {url}"
                        log_file.write(f"INFO: {msg} \n")
                    else:
                        msg = f"Unable to delete file from WordPress: {backup_file} using URL: {url}"
                        log_file.write(f"INFO: {msg} \n")
                else:
