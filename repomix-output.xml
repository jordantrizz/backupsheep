                /**
                 * Create or Update Schedule. If there's ID then we will make update request, otherwise add request
                 * @returns {Promise<void>}
                 */
                async saveSchedule() {
                    this.loading = true;
                    Alpine.store('showLoading').toggle();

                    let url = "/api/v1/schedules/";
                    let method = "POST";

                    if (this.schedule.id) {
                        url += this.schedule.id + "/";
                        method = "PATCH";
                    }

                    let data = this.schedule;
                    data.node = this.node_id;
                    data.location = this.location_id;

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: method,
                        body: JSON.stringify(data)
                    }).then(async (response) => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            this.loading = false;
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            this.scheduleErrors = json;
                            json.detail = this.scheduleErrors.non_field_errors[0];
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        this.closeScheduleModal();
                        location.reload();
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                        Alpine.store('showLoading').toggle();
                        {#this.closeScheduleModal();#}
                    });
                },
                async toggleNotification(notificationType) {
                    this.loading = true;

                    let data = {
                        location: this.location_id,
                    }

                    if (notificationType === "success") {
                        this.notify_on_success = !this.notify_on_success;
                        data.notify_on_success = this.notify_on_success;
                    } else if (notificationType === "fail") {
                        this.notify_on_fail = !this.notify_on_fail;
                        data.notify_on_fail = this.notify_on_fail;
                    }

                    let url = "/api/v1/nodes/" + this.node_id + "/";


                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'PATCH',
                        body: JSON.stringify(data)
                    }).then(async (response) => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });

                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async validateConnection() {
                    Alpine.store('showLoading').toggle("Checking {{ object.connection.integration.name|lower }} status with {{ object.connection.integration.name }}.", "Integration Validation");

                    let url = null;
                    let method = null;

                    url = "/api/proxy/connections/{{ object.connection.integration.code }}/{{ object.connection.id }}/validate?" + new URLSearchParams({
                        location: {{ object.connection.location.id }},
                    });
                    method = "GET";

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: method,
                    }).then(async (response) => {

                        Alpine.store('showLoading').toggle();
                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async validateNode() {
                    Alpine.store('showLoading').toggle("Checking {{ object.get_type_display|lower }} status with {{ object.connection.integration.name }}.", "Node Validation");

                    let url = "/api/proxy/nodes/" + {{object.id}} +"/validate" + "/?" + new URLSearchParams({
                        location: {{ object.connection.location.id }},
                    });

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'GET',
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();

                        if (response.ok) {
                            return response.json();
                        } else {
                            this.loading = false;
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }
                            this.connectionErrors = json;
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Validation Passed!',
                            details: json.detail
                        });
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Validation Failed!',
                            details: error.message
                        });
                        {#this.closeConnectionModal();#}
                    });
                },
                async validateStorage(storage_id, storage_code) {
                    Alpine.store('showLoading').toggle();

                    let method = "GET";
                    let url = "/api/proxy/storage/" + storage_code + "/" + storage_id + "/validate" + "/?" + new URLSearchParams({
                        location: {{ object.connection.location.id }},
                    });

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: method,
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();
                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },

            }));
        });
    </script>
