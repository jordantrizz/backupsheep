    class Meta:
        db_table = "core_auth_wordpress"

    def get_client(self):
        user_agent = (
            "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_9_3) AppleWebKit/537.75.14"
            " (KHTML, like Gecko) Version/7.0.3 Safari/7046A194A"
        )
        try:
