                        {% endif %}
                        {% if connection.auth_database.type == 3 %}
                            <div class="sm:col-span-1">
                                <label for="option_postgres" class="block text-sm font-medium text-gray-700">
                                    PostgresSQL(pg_dump) Options (<a class="text-indigo-500" target="_blank" href="https://support.backupsheep.com/docs/postgresql-pg_dump-options">allowed options</a>)
                                </label>
                               <div class="mt-1">
                                          <textarea placeholder="Example: --column-inserts --no-owner --no-comments --no-privileges --rows-per-insert=500 --if-exists --clean" x-model="database.option_postgres" id="option_postgres" name="option_postgres" rows="3"
