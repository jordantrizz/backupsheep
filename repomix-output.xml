                        f"open -p {lftp['port']} {lftp['host']}\n"
                        f'user "{lftp["user"]}" "{lftp_pass}"\n'
                        f'get -P {parallel} "{lftp["source"]}" -o "{working_dir}/{lftp["target"]}"\n'
                        f"bye\n'"
                    )

                else:
                    if (
