                                        <input id="rate" value="rate" x-model="schedule.type" name="schedule-type" type="radio" class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500">
                                        <label for="rate" class="ml-3 block text-sm font-medium text-gray-700">Rate-based</label>
                                      </div>
                                      <div class="flex items-center">
                                        <input id="cron"  value="cron" x-model="schedule.type" name="schedule-type" type="radio" class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500">
                                        <label for="cron" class="ml-3 block text-sm font-medium text-gray-700">Cron-based</label>
                                      </div>
{#                                      <div class="flex items-center">#}
{#                                        <input id="onetime"  value="at" x-model="schedule.type" name="schedule-type" type="radio" class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500">#}
{#                                        <label for="onetime" class="ml-3 block text-sm font-medium text-gray-700">One-time</label>#}
{#                                      </div>#}
                                    </div>
                                  </fieldset>
                                     <p x-show="scheduleErrors.type" class="mt-2 text-sm text-red-600"
                                       id="type-error"
                                       x-text="scheduleErrors.type"></p>
                                </div>
                                <p x-show="scheduleErrors.non_field_errors" class="mt-2 text-sm text-red-600"
                                       id="non_field_errors-error"
                                       x-text="scheduleErrors.non_field_errors"></p>
                            </div>
                            <div x-show="schedule.type=='rate'" class="sm:col-span-3">
                                <label for="rate_value" class="block text-sm font-medium text-gray-700">
