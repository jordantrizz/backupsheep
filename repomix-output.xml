            </div>


            <div class="bg-white shadow overflow-hidden sm:rounded-lg mt-6"
                 x-show="(database.tables?.length>0 || database.databases?.length>0)  && (!database.all_tables && !database.all_databases)">
                <div class="px-2 py-3 sm:px-2  bg-indigo-500">
