                             class="text-gray-400 group-hover:text-gray-700 flex-shrink-0 -ml-1 mr-3 h-6 w-6"
                             fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path>
                        </svg>
                        <span class="truncate">
                      Invites
                    </span>
                    </a>
                {% endif %}
                {% if account.billing.plan.name == "AppSumo" %}
                    <a href="{% url 'console:settings:appsumo' %}"
                       class="text-gray-700 hover:text-gray-700 hover:bg-gray-50 group rounded-md px-3 py-2 flex items-center text-sm font-medium">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="text-gray-400 group-hover:text-gray-700 flex-shrink-0 -ml-1 mr-3 h-6 w-6"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path>
                        </svg>
                        <span class="truncate">
                      AppSumo
                    </span>
                    </a>
                {% endif %}
                {% if not is_appsumo_plan %}
                    <a href="{% url 'console:settings:notification' %}"
                       class="text-gray-700 hover:text-gray-700 hover:bg-gray-50 group rounded-md px-3 py-2 flex items-center text-sm font-medium">
                        <svg class="text-gray-400 group-hover:text-gray-700 flex-shrink-0 -ml-1 mr-3 h-6 w-6"
                             xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                             aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M17 14v6m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z"></path>
                        </svg>
                        <span class="truncate">
                                          Notifications
                                        </span>
                    </a>
                {% endif %}
            </nav>
        </aside>
        <div class="space-y-6 sm:px-6 lg:px-0 lg:col-span-9">
            <div class="shadow sm:rounded-md">
                <div class="bg-white py-6 px-4 space-y-6 sm:p-6">
                    <div>
                        <h2 id="payment-details-heading" class="text-lg leading-6 font-medium text-gray-900">
                            Multi-Factor Authentication</h2>
                        <p class="mt-1 text-sm text-gray-500">You can use authenticator apps like Authy, Google
                            Authenticator.</p>
                    </div>
                    <div class="flex items-center justify-between" x-show="memberErrors.non_field_errors">
                        <template x-for="non_field_error in memberErrors.non_field_errors">
                            <div class="rounded-md bg-red-50 p-2 w-full">
                                <div class="flex">
                                    <div class="text-sm text-red-700">
                                        <p x-text="non_field_error"></p>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                    <div class="grid grid-cols-6 gap-6">

                        <div class="col-span-6 sm:col-span-3">
                            <label for="displayName" class="block text-sm font-medium text-gray-700">Display
                                Name</label>
                            <input x-model="member.display_name" type="text" name="displayName" id="displayName"
                                    {% if request.user.member.auth_multi_factor_display_name %} readonly{% endif %}
                                   autocomplete="displayName"
                                   class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                            <p x-show="memberErrors.display_name" class="mt-2 text-sm text-red-600"
                               id="displayName-error"
                               x-text="memberErrors.display_name"></p>
                        </div>
                        <div class="col-span-6 sm:col-span-3" x-show="binding?.uri">
                            <label for="verificationId" class="block text-sm font-medium text-gray-700">Verify
                                Token</label>
                            <input x-model="member.auth_multi_factor_token" type="text" name="verificationCode"
                                   id="verify_token"
                                   placeholder=""
                                   autocomplete="verify_token"
                                   class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                            <p x-show="memberErrors.auth_multi_factor_token" class="mt-2 text-sm text-red-600"
                               id="verificationCode-error"
                               x-text="memberErrors.auth_multi_factor_token"></p>
                        </div>
                        <div class="col-span-6 sm:col-span-3" x-show="binding.uri">
                            <label for="uri" class="block text-sm font-medium text-gray-700">URI</label>
                            <input x-model="binding.uri" type="text" name="uri"
                                   id="uri"
                                   readonly
                                   class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                        </div>
                        <div class="col-span-6 sm:col-span-3" x-show="binding.secret">
                            <label for="secret" class="block text-sm font-medium text-gray-700">Secret</label>
                            <input x-model="binding.secret" type="text" name="secret"
                                   id="secret"
                                   readonly
                                   class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <div id="qrcode"></div>
                        </div>
                    </div>
                </div>
                <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
                    <button @click="setupTokenAuth()" x-show="!member.auth_multi_factor_id"
                            class="bg-indigo-600 border border-transparent rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Setup Token Auth
                    </button>
                    <button @click="verifyTokenAuth()" x-show="member.auth_multi_factor_id && binding.uri"
                            class="bg-indigo-600 border border-transparent rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Verify Token Auth
                    </button>
                    <button @click="revokeTokenAuth()" x-show="member.auth_multi_factor_id && !binding.uri"
                            class="bg-red-600 border border-transparent rounded-md shadow-sm py-2 px-4 inline-flex justify-center text-sm font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        Revoke Token Auth
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('settingsMultiFactor', () => ({
                memberErrors: {},
                member: {
                    display_name: null,
                    auth_multi_factor_id: null,
                    auth_multi_factor_token: null,
                },
                binding: {},
                recaptchaVerifier: null,
                verificationId: null,
                verificationCode: null,
                showMultiFactorAuth: null,
                init() {//user.providerData[0].providerId
                    {% if request.user.member.auth_multi_factor_id %}
                        this.member.auth_multi_factor_id = "{{ request.user.member.auth_multi_factor_id }}";
                        this.member.display_name = "{{ request.user.member.auth_multi_factor_display_name }}";
                    {% endif %}
                },
                async setupTokenAuth() {
                    Alpine.store('showLoading').toggle("Configuring two-factor authentication.");

                    let url = "/api/v1/members/" + {{ request.user.member.id }} +"/auth_multi_factor_token_setup/";

                    let data = this.member;

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'POST',
                        body: JSON.stringify(data)
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();

                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            this.memberErrors = json;
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        this.binding = json.binding;
                        this.member.auth_multi_factor_id = json.auth_multi_factor_id;
                        new QRCode(document.getElementById("qrcode"), this.binding.uri);
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async verifyTokenAuth() {
                    Alpine.store('showLoading').toggle("Configuring two-factor authentication.");

                    let url = "/api/v1/members/" + {{ request.user.member.id }} +"/auth_multi_factor_token_verify/";

                    let data = this.member;

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'POST',
                        body: JSON.stringify(data)
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();

                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            this.memberErrors = json;
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        window.location.reload();
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async revokeTokenAuth() {
                    Alpine.store('showLoading').toggle("Revoking two-factor authentication.");

                    let url = "/api/v1/members/" + {{ request.user.member.id }} +"/auth_multi_factor_token_revoke/";

                    let data = this.member;

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'POST',
                        body: JSON.stringify(data)
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();

                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            this.memberErrors = json;
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        window.location.reload();
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },

            }));
        });
    </script>
{% endblock %}
</file>

