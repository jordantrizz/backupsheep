                            </label>
                            <div class="mt-1">
                                          <textarea x-model="database.notes" id="notes" name="notes" rows="3"
                                                    class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border border-gray-300 rounded-md mt-3"></textarea>
                                <p x-show="databaseErrors?.notes" class="mt-2 text-sm text-red-600" id="notes-error"
                                   x-text="databaseErrors?.notes"></p>
