                        <span>Add Channel</span>
                    </button>
                </div>
            </div>

        </div>
    </div>
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('settingsNotifications', () => ({
                notificationErrors: {},
                telegram: {},
                init() {
                },
                async validateSlack(notification_id) {
                    Alpine.store('showLoading').toggle("Validation...");

                    let url = "/api/v1/notifications-slack/" + notification_id + "/validate/";

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'GET',
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();

                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async removeSlack(notification_id) {
                    Alpine.store('showLoading').toggle();

                    let url = "/api/v1/notifications-slack/" + notification_id + "/";

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'DELETE',
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();
                        if (response.status === 204) {
                            return {"detail": "Notification integration is deleted."};
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        location.reload();
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },

                async addTelegram() {
                    Alpine.store('showLoading').toggle("Saving invite details.");

                    let url = "/api/v1/notifications-telegram/";
                    let method = "POST";

                    let data = this.telegram

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: method,
                        body: JSON.stringify(data)
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();
                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                                this.notificationErrors = json;
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }
                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        window.location.reload();
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async validateTelegram(notification_id) {
                    Alpine.store('showLoading').toggle("Validation...");

                    let url = "/api/v1/notifications-telegram/" + notification_id + "/validate/";

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'GET',
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();

                        if (response.ok) {
                            return response.json();
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
                async removeTelegram(notification_id) {
                    Alpine.store('showLoading').toggle();

                    let url = "/api/v1/notifications-telegram/" + notification_id + "/";

                    let response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        method: 'DELETE',
                    }).then(async (response) => {
                        Alpine.store('showLoading').toggle();
                        if (response.status === 204) {
                            return {"detail": "Notification integration is deleted."};
                        } else {
                            let json;
                            try {
                                json = await response.json();
                            } catch (exception_var) {
                                json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                            }

                            throw new Error(json.detail);
                        }
                    }).then((json) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            success: true,
                            heading: 'Success!',
                            details: json.detail
                        });
                        location.reload();
                    }).catch((error) => {
                        Alpine.store('notifications').items.push({
                            show: true,
                            error: true,
                            heading: 'Error!',
                            details: error.message
                        });
                    });
                },
            }));
        });
    </script>

{% endblock %}
</file>

