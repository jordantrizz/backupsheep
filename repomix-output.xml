        ref_name = "Storage IBM Write"
        fields = "__all__"

    def create(self, validated_data):
        storage_ibm = validated_data.pop("storage_ibm", [])
        instance = CoreStorage.objects.create(**validated_data)
        storage_ibm["storage"] = instance
        CoreStorageIBM.objects.create(**storage_ibm)
        return instance

    def update(self, instance, validated_data):
        storage_ibm = validated_data.pop("storage_ibm", [])
        super().update(instance.storage_ibm, storage_ibm)
        instance = super().update(instance, validated_data)
        return instance
