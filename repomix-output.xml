    def check_connection(self, data=None, check_errors=None):
        import ftputil
        from apps.api.v1.utils.api_helpers import bs_decrypt, FtpSession, FtpTlsSession
        import paramiko
        import tempfile
        import os

        if data:
            username = data.get("username")
