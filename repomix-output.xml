            "Input": json.dumps(
                {"host": host, "path": path, "token": token}
            ),
        }

        flex_window = {"Mode": "OFF"}

        state = "ENABLED"

        aws_schedule = {
            "Name": self.uuid_str,
            "State": state,
            "ScheduleExpression": self.aws_schedule_expression(),
            "ScheduleExpressionTimezone": self.timezone,
            "Target": schedule_settings,
            "FlexibleTimeWindow": flex_window,
