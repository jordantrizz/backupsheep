                                           class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md">
                                    <p x-show="scheduleErrors.rate_value" class="mt-2 text-sm text-red-600"
                                       id="rate_value-error"
                                       x-text="scheduleErrors.rate_value"></p>
                                </div>

                            </div>
                            <div x-show="schedule.type=='rate'" class="sm:col-span-3">
