def sizify(value):
    """
    Simple kb/mb/gb size snippet for templates:

    {{ product.file.size|sizify }}
    """
    # value = ing(value)
    if value < 512000:
        value = value / 1024.0
        ext = "kb"
    elif value < 4194304000:
        value = value / 1048576.0
        ext = "mb"
    else:
        value = value / 1073741824.0
        ext = "gb"
    return f"{str(round(value, 2))} {ext}"


