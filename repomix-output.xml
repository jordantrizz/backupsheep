                data['hour'] = None
                data['day_of_month'] = None
                data['month_of_year'] = None
                data['day_of_week'] = None
                data['year'] = None
            elif data["type"] == CoreSchedule.Type.ONETIME:
                schedule_expression = f"at({data['onetime_datetime']})"
                data['rate_value'] = None
                data['rate_unit'] = None
                data['minute'] = None
                data['hour'] = None
                data['hour'] = None
                data['day_of_month'] = None
                data['month_of_year'] = None
                data['day_of_week'] = None
