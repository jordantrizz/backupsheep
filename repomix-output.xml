<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('setupDatabaseNode', () => ({
            loading: true,
            error: null,
            errorObjectList: null,
            objectList: null,
            connection: {},
            database: {
                all_databases: false,
                all_tables: false,
                databases: [],
                tables: [],
                name: null,
                notes: null,
            },
            databaseErrors: {},
            integration_code: "{{integration.code}}",
            connection_id: "{{connection.id}}",
            location_id: "{{connection.location.id}}",
            object_type: "{{object_code}}",
            node_id: "{{node_id}}",

            init() {
                this.loading = true;
                this.getObjects();
            },

            openUrl(url) {
                window.location.href = url;
            },
            addTable(object) {
                if (!this.database.tables.includes(object)) {
                    this.database.tables.push(object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included tables list updated."
                    });
                }
            },
            removeTable(object) {
                if (this.database.tables.includes(object)) {
                    this.database.tables = this.database.tables.filter(el => el !== object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included tables list updated."
                    });
                }
            },
            addDatabase(object) {
                if (!this.database.databases.includes(object)) {
                    this.database.databases.push(object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included database list updated."
                    });
                }
            },
            removeDatabase(object) {
                if (this.database.databases.includes(object)) {
                    this.database.databases = this.database.databases.filter(el => el !== object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included database list updated."
                    });
                }
            },
            async getObjects(path) {
                this.loading = true;
                this.errorObjectList = null;

                {% if node.id %}
                    await this.getDatabase();
                {% endif %}

                let params = {
                    location: this.location_id,
                }

                if (path) {
                    params.path = path;
                }
                let url = "/api/proxy/connections/" + this.integration_code + "/" + this.connection_id + "/objects/?" + new URLSearchParams(params);

                let response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    method: 'GET',
                }).then(async (response) => {
                    if (response.ok) {
                        return response.json();
                    } else {
                        this.loading = false;
                        let json;
                        try {
                            json = await response.json();
                        } catch (exception_var) {
                            json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                        }

                        this.scheduleErrors = json;
                        throw new Error(json.detail);
                    }
                }).then((json) => {
                    {#Alpine.store('notifications').items.push({show: true, success: true, heading: 'OAuth URL Ready!', details: json.detail});#}
                    this.objectList = json;
                    this.loading = false;
                }).catch((error) => {
                    Alpine.store('notifications').items.push({
                        show: true,
                        error: true,
                        heading: 'Error!',
                        details: error.message
                    });
                    this.errorObjectList = error;
                });
            },
            async getDatabase() {
                let params = {}

                let url = "/api/v1/" + this.integration_code + "s/" + "{{node.database.id}}" + "/?" + new URLSearchParams(params);

                let response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    method: 'GET',
                }).then(async (response) => {
                    if (response.ok) {
                        return response.json();
                    } else {
                        let json;
                        try {
                            json = await response.json();
                        } catch (exception_var) {
                            json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                        }

                        this.databaseErrors = json;
                        throw new Error(json.detail);
                    }
                }).then((json) => {
                    this.database = json;
                    if (this.database.tables === null) {
                        this.database.tables = [];
                    }
                    if (this.database.databases === null) {
                        this.database.databases = [];
                    }

                    {% if connection.auth_database.database_name %}
                         this.database.all_databases = false;
                    {% elif connection.auth_database.all_databases %}
                         this.database.all_tables = false;
                    {% endif %}

                }).catch((error) => {
                    this.error = error;
                });
            },

            async saveDatabase() {
                Alpine.store('showLoading').toggle();

                let url = "";
                let method = "";

                let data = {
                    node: {
                        connection: this.connection_id,
                        name: this.database.name,
                    },
                    location: this.location_id,
                    all_tables: this.database.all_tables,
                    tables: this.database.tables,
                    all_databases: this.database.all_databases,
                    option_gtid_purged_off: this.database.option_gtid_purged_off,
                    option_postgres: this.database.option_postgres,
                    databases: this.database.databases,
                    name: this.database.name,
                    notes: this.database.notes
                };

                if (this.database.id) {
                    url = "/api/v1/databases/" + this.database.id + "/";
                    method = "PATCH";
                } else {
                    url = "/api/v1/databases/";
                    method = "POST";
                }

                if (this.database.all_tables === true) {
                    data.tables = null;
                }

                if (this.database.all_databases === true) {
                    data.databases = null;
                }

                let response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    method: method,
                    body: JSON.stringify(data)
                }).then(async (response) => {
                    if (response.ok) {
                        return response.json();
                    } else {
                        this.loading = false;
                        let json;
                        try {
                            json = await response.json();
                        } catch (exception_var) {
                            json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                        }

                        this.databaseErrors = json;
                        throw new Error(json.detail);
                    }
                }).then((json) => {
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Node successfully linked.',
                        details: json.detail
                    });
                    Alpine.store('showLoading').toggle();
                    if (this.database.id) {
                        window.location.reload();
                    } else {
                        window.location.href = "/console/nodes/" + json.node.id;
                    }
                }).catch((error) => {
                    Alpine.store('notifications').items.push({
                        show: true,
                        error: true,
                        heading: 'Error!',
                        details: error.message
                    });
                    this.error = error;
                    Alpine.store('showLoading').toggle();
                });
            },
        }));
    });
</script>
