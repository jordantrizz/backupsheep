    <div class="lg:grid lg:grid-cols-12 lg:gap-x-5" x-data="settingsNotifications()">
        <aside class="py-6 px-2 sm:px-6 lg:py-0 lg:px-0 lg:col-span-3">
            <nav class="space-y-1">
                <a href="{% url 'console:settings:profile' %}"
