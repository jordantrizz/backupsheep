            r.close()
        except Exception as e:
            self.status = UtilBackup.Status.DELETE_FAILED
            self.save()
            msg = (
                f"Backup {self.uuid_str} of node {self.vultr.node.name} "
                f"failed to using connection {self.vultr.node.connection.name}. Error: {e.__str__()}"
            )
        finally:
