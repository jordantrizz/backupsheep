        return client

    def get_auth(self, data=None):
        if data:
            http_user = data.get("http_user")
            http_pass = data.get("http_pass")
        else:
            http_user = self.http_user
            http_pass = self.http_pass
        auth = None
        if http_user and http_pass:
            auth = (http_user, http_pass)
