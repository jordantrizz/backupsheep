                            <div class="mt-1">
                                          <textarea x-model="database.notes" id="notes" name="notes" rows="3"
                                                    class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border border-gray-300 rounded-md mt-3"></textarea>
                                <p x-show="databaseErrors?.notes" class="mt-2 text-sm text-red-600" id="notes-error"
                                   x-text="databaseErrors?.notes"></p>
                            </div>
                        </div>

                        <div class="sm:col-span-1" x-show="!errorObjectList">
                            <button @click="saveDatabase()" type="button"
                                    class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-indigo-600 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:col-start-2 sm:text-sm">
                                {% if not node.id %}
                                    <span>Create Node</span>
                                {% elif node.id %}
                                    <span>Modify Node</span>
                                {% endif %}
                            </button>
                        </div>
                    </dl>
                </div>
            </div>


            <div class="bg-white shadow overflow-hidden sm:rounded-lg mt-6"
                 x-show="(database.tables?.length>0 || database.databases?.length>0)  && (!database.all_tables && !database.all_databases)">
                <div class="px-2 py-3 sm:px-2  bg-indigo-500">
                    <h3 class="text-md leading-6  text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 float-left mr-1" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 4v16m8-8H4"></path>
                        </svg>
                        Included {% if connection.auth_database.database_name %}
                        Tables{% elif connection.auth_database.all_databases %}Databases{% endif %}
                    </h3>
                </div>
                <div class="border-t border-gray-200 px-4 py-6 pb-7 sm:px-6">
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-1">
                        <div class="border-t border-gray-200 ">
                            <div class="overflow-x-auto">
                                <table id="section-nodes" class="min-w-full divide-y divide-gray-200">
                                    <tbody class="bg-white divide-y divide-gray-200">

                                    {% if connection.auth_database.database_name %}
                                        <template x-for="object in database.tables">
                                            <tr>
                                                <td class="px-2 py-2 whitespace-nowrap">
                                                    <div class="flex items-center">
                                                        <div class="flex-shrink-0 h-6 w-6">
                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                 class="h-6 w-6 rounded-full text-indigo-600"
                                                                 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                      stroke-width="2"
                                                                      d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                                                            </svg>
                                                        </div>
                                                        <div class="ml-2">
                                                            <div class="text-sm font-medium text-gray-700">
                                                                <a class="cursor-pointer" x-text="object"></a>
                                                            </div>
                                                            <div class="text-xs text-gray-700" x-text="object"></div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="px-2 py-2 whitespace-nowrap text-right text-sm font-medium">
                                                    <button @click="removeTable(object)" type="button"
                                                            class="mt-3 inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-2 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:col-start-1 sm:text-sm">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        </template>

                                    {% elif connection.auth_database.all_databases %}
                                        <template x-for="object in database.databases">
                                            <tr>
                                                <td class="px-2 py-2 whitespace-nowrap">
                                                    <div class="flex items-center">
                                                        <div class="flex-shrink-0 h-6 w-6">
                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                 class="h-6 w-6 rounded-full text-indigo-600"
                                                                 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                      stroke-width="2"
                                                                      d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                                                            </svg>
                                                        </div>
                                                        <div class="ml-2">
                                                            <div class="text-sm font-medium text-gray-700">
                                                                <a class="cursor-pointer" x-text="object"></a>
                                                            </div>
                                                            <div class="text-xs text-gray-700" x-text="object"></div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="px-2 py-2 whitespace-nowrap text-right text-sm font-medium">
                                                    <button @click="removeDatabase(object)" type="button"
                                                            class="mt-3 inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-2 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:col-start-1 sm:text-sm">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        </template>

                                    {% endif %}


                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('setupDatabaseNode', () => ({
            loading: true,
            error: null,
            errorObjectList: null,
            objectList: null,
            connection: {},
            database: {
                all_databases: false,
                all_tables: false,
                databases: [],
                tables: [],
                name: null,
                notes: null,
            },
            databaseErrors: {},
            integration_code: "{{integration.code}}",
            connection_id: "{{connection.id}}",
            location_id: "{{connection.location.id}}",
            object_type: "{{object_code}}",
            node_id: "{{node_id}}",

            init() {
                this.loading = true;
                this.getObjects();
            },

            openUrl(url) {
                window.location.href = url;
            },
            addTable(object) {
                if (!this.database.tables.includes(object)) {
                    this.database.tables.push(object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included tables list updated."
                    });
                }
            },
            removeTable(object) {
                if (this.database.tables.includes(object)) {
                    this.database.tables = this.database.tables.filter(el => el !== object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included tables list updated."
                    });
                }
            },
            addDatabase(object) {
                if (!this.database.databases.includes(object)) {
                    this.database.databases.push(object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included database list updated."
                    });
                }
            },
            removeDatabase(object) {
                if (this.database.databases.includes(object)) {
                    this.database.databases = this.database.databases.filter(el => el !== object);
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Success!',
                        details: "Included database list updated."
                    });
                }
            },
            async getObjects(path) {
                this.loading = true;
                this.errorObjectList = null;

                {% if node.id %}
                    await this.getDatabase();
                {% endif %}

                let params = {
                    location: this.location_id,
                }

                if (path) {
                    params.path = path;
                }
                let url = "/api/proxy/connections/" + this.integration_code + "/" + this.connection_id + "/objects/?" + new URLSearchParams(params);

                let response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    method: 'GET',
                }).then(async (response) => {
                    if (response.ok) {
                        return response.json();
                    } else {
                        this.loading = false;
                        let json;
                        try {
                            json = await response.json();
                        } catch (exception_var) {
                            json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                        }

                        this.scheduleErrors = json;
                        throw new Error(json.detail);
                    }
                }).then((json) => {
                    {#Alpine.store('notifications').items.push({show: true, success: true, heading: 'OAuth URL Ready!', details: json.detail});#}
                    this.objectList = json;
                    this.loading = false;
                }).catch((error) => {
                    Alpine.store('notifications').items.push({
                        show: true,
                        error: true,
                        heading: 'Error!',
                        details: error.message
                    });
                    this.errorObjectList = error;
                });
            },
            async getDatabase() {
                let params = {}

                let url = "/api/v1/" + this.integration_code + "s/" + "{{node.database.id}}" + "/?" + new URLSearchParams(params);

                let response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    method: 'GET',
                }).then(async (response) => {
                    if (response.ok) {
                        return response.json();
                    } else {
                        let json;
                        try {
                            json = await response.json();
                        } catch (exception_var) {
                            json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                        }

                        this.databaseErrors = json;
                        throw new Error(json.detail);
                    }
                }).then((json) => {
                    this.database = json;
                    if (this.database.tables === null) {
                        this.database.tables = [];
                    }
                    if (this.database.databases === null) {
                        this.database.databases = [];
                    }

                    {% if connection.auth_database.database_name %}
                         this.database.all_databases = false;
                    {% elif connection.auth_database.all_databases %}
                         this.database.all_tables = false;
                    {% endif %}

                }).catch((error) => {
                    this.error = error;
                });
            },

            async saveDatabase() {
                Alpine.store('showLoading').toggle();

                let url = "";
                let method = "";

                let data = {
                    node: {
                        connection: this.connection_id,
                        name: this.database.name,
                    },
                    location: this.location_id,
                    all_tables: this.database.all_tables,
                    tables: this.database.tables,
                    all_databases: this.database.all_databases,
                    option_gtid_purged_off: this.database.option_gtid_purged_off,
                    option_postgres: this.database.option_postgres,
                    databases: this.database.databases,
                    name: this.database.name,
                    notes: this.database.notes
                };

                if (this.database.id) {
                    url = "/api/v1/databases/" + this.database.id + "/";
                    method = "PATCH";
                } else {
                    url = "/api/v1/databases/";
                    method = "POST";
                }

                if (this.database.all_tables === true) {
                    data.tables = null;
                }

                if (this.database.all_databases === true) {
                    data.databases = null;
                }

                let response = await fetch(url, {
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    method: method,
                    body: JSON.stringify(data)
                }).then(async (response) => {
                    if (response.ok) {
                        return response.json();
                    } else {
                        this.loading = false;
                        let json;
                        try {
                            json = await response.json();
                        } catch (exception_var) {
                            json = {detail: response.status + " - " + response.statusText + ". Please contact support."};
                        }

                        this.databaseErrors = json;
                        throw new Error(json.detail);
                    }
                }).then((json) => {
                    Alpine.store('notifications').items.push({
                        show: true,
                        success: true,
                        heading: 'Node successfully linked.',
                        details: json.detail
                    });
                    Alpine.store('showLoading').toggle();
                    if (this.database.id) {
                        window.location.reload();
                    } else {
                        window.location.href = "/console/nodes/" + json.node.id;
                    }
                }).catch((error) => {
                    Alpine.store('notifications').items.push({
                        show: true,
                        error: true,
                        heading: 'Error!',
                        details: error.message
                    });
                    this.error = error;
                    Alpine.store('showLoading').toggle();
                });
            },
        }));
    });
</script>
</file>

