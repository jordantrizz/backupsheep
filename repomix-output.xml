                stderr=subprocess.PIPE,
                shell=True,
                timeout=900,
                cwd=local_dir
            )
            log_file.write(f"---Directory Tree--- \n")

            # open both files
            with open(tree_log_path, 'r', errors="ignore") as tree_log_file:
                for line in tree_log_file:
